# Required initial administrator password.
ADMIN_PASSWORD=change_me_generate_secure_password

# Optional time zone (default: Europe/Berlin).
TZ=Europe/Berlin

# Host directories exposed in File Browser (defaults preserve current mounts).
FILEBROWSER_PRIVATE_PATH=/mnt/files/Filebrowser/_private
FILEBROWSER_FHDW_PATH=/mnt/files/Filebrowser/fhdw
FILEBROWSER_USERS_PATH=/mnt/files/Filebrowser/users
MEDIA_ANIME_PATH=/mnt/files/Mediaserver/Anime
MEDIA_SHOWS_PATH=/mnt/files/Mediaserver/Shows
MEDIA_MOVIES_PATH=/mnt/files/Mediaserver/Movies
