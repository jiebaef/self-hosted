# Host identity and time zone.
PUID=1000
PGID=1000
TZ=Europe/Berlin
MEDIASERVER_PATH=/mnt/files/Mediaserver

# Published ports.
QBIT_TORRENTING_PORT=6881
QBIT_WEBUI_PORT=8080
PROWLARR_WEBUI_PORT=9696
RADARR_WEBUI_PORT=7878
SONARR_WEBUI_PORT=8989
BAZARR_WEBUI_PORT=6767
READARR_WEBUI_PORT=8787

# VPN provider settings. Supply credentials from your VPN provider.
GLUETUN_VPN_SERVICE_PROVIDER=change_me
GLUETUN_VPN_TYPE=wireguard
GLUETUN_WIREGUARD_PRIVATE_KEY=change_me_generate_or_obtain_from_provider
GLUETUN_WIREGUARD_PRESHARED_KEY=change_me_obtain_from_provider
GLUETUN_WIREGUARD_ADDRESSES=change_me
GLUETUN_SERVER_COUNTRIES=change_me
GLUETUN_FIREWALL_OUTBOUND_SUBNETS=change_me
