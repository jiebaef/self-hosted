# Required database credentials; keep consistent with the Paperless database.
PAPERLESS_DBNAME=paperless
PAPERLESS_DBUSER=paperless
PAPERLESS_DBPASS=change_me_generate_secure_password
PAPERLESS_MEDIA_PATH=/mnt/files/docker_data/paperless/media
PAPERLESS_EXPORT_PATH=/mnt/files/docker_data/paperless/export

# Required SSO settings. Replace the example values with the Authentik provider
# settings. Keep this JSON on one line; the client secret belongs only in local .env.
PAPERLESS_APPS=allauth.socialaccount.providers.openid_connect
PAPERLESS_SOCIAL_ACCOUNT_SYNC_GROUPS=true
PAPERLESS_SOCIALACCOUNT_PROVIDERS={"openid_connect":{"APPS":[{"provider_id":"authentik","name":"Authentik","client_id":"change_me_client_id","secret":"change_me_generate_or_obtain_client_secret","settings":{"server_url":"https://authentik.example.com/application/o/paperless/.well-known/openid-configuration"}}],"OAUTH_PKCE_ENABLED":"True","SCOPE":["openid","profile","email","groups"]}}
