# Required database credentials; generate a unique password.
PG_PASS=change_me_generate_secure_password
PG_USER=authentik
PG_DB=authentik

# Required Authentik signing/encryption secret; generate a long random value.
AUTHENTIK_SECRET_KEY=change_me_generate_secure_secret

# Optional image selection.
AUTHENTIK_IMAGE=ghcr.io/goauthentik/server
AUTHENTIK_TAG=2025.2.3
