# Host identity and time zone.
PUID=1000
PGID=1000
TZ=Europe/Berlin

# Required application key; generate a unique key using the app's documented method.
APP_KEY=change_me_generate_secure_application_key

# Database credentials shared by Speedtest Tracker and PostgreSQL.
PG_DB=speedtest
PG_USER=speedtest
PG_PASS=change_me_generate_secure_password
