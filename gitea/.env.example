# Host identity (UID/GID variable names retained for compatibility).
UID=1000
GID=1000

# PostgreSQL settings shared by Gitea and its database container.
POSTGRES_PORT=5432
POSTGRES_DB=gitea
POSTGRES_USER=gitea
POSTGRES_PASSWORD=change_me_generate_secure_password

# Optional host data directory (default: ./data/gitea).
DATA_DIR=./data/gitea
